      "targets": [
        {
          "editorMode": "code",
          "format": "table",
          "rawQuery": true,
          "rawSql": "SELECT\n  product AS \"Product\",\n  SUM(\n    CASE\n      WHEN sentiment = 'POSITIVE' THEN 1\n      ELSE 0\n    END\n  ) AS \"POSITIVE\",\n  SUM(\n    CASE\n      WHEN sentiment = 'NEUTRAL' THEN 1\n      ELSE 0\n    END\n  ) AS \"NEUTRAL\",\n  SUM(\n    CASE\n      WHEN sentiment = 'NEGATIVE' THEN 1\n      ELSE 0\n    END\n  ) AS \"NEGATIVE\"\nFROM\n  reviews\nWHERE\n  product IN ($product)\nGROUP BY\n  product\nORDER BY\n  product;",
          "refId": "A",
