          "rawSql": "SELECT\n  product AS \"Product\",\n  ROUND(AVG(sentiment_score) :: numeric, 1) AS \"Unweighted\",\n  ROUND(\n    (SUM(sentiment_score * weight) / SUM(weight)) :: numeric,\n    1\n  ) AS \"Weighted\"\nFROM\n  review_analysis\nWHERE\n  product IN ($product)\nGROUP BY\n  product\nORDER BY\n  product;",
